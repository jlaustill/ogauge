#include <Arduino.h>
#include "signal_data.cnx"

scope J1939Decoder {

  // Source addresses — which module owns which signals on this bus.
  // The TCM (SA_TCM) re-broadcasts overlapping PGNs (oil temp, RPM, ...);
  // gating each PGN to its expected SA stops it from clobbering real data.
  const u8 SA_ECM <- 0;     // Engine ECM: RPM, odometer
  const u8 SA_SENSOR <- 1;  // OSSM sensor module: EGT, oil, fuel, ambient, humidity
  const u8 SA_TCM <- 3;     // Transmission control module (not yet decoded)

  private u16 extract_u16(u8[8] data, u8 byte_lo, u8 byte_hi) {
    u16 raw <- 0;
    raw[0, 8] <- data[byte_lo];
    raw[8, 8] <- data[byte_hi];
    return raw;
  }

  private u32 extract_u32(u8[8] data, u8 b0, u8 b1, u8 b2, u8 b3) {
    u32 raw <- 0;
    raw[0, 8] <- data[b0];
    raw[8, 8] <- data[b1];
    raw[16, 8] <- data[b2];
    raw[24, 8] <- data[b3];
    return raw;
  }

  private void decode_65269(u8[8] data) {
    // SPN 108 - Barometric Pressure: byte 0, 1 byte, 0.5 kPa/bit
    u8 raw108 <- data[0];
    SignalStore.current.barometric_pressure_kpa.value <- raw108 * 0.5;
    SignalStore.current.barometric_pressure_kpa.time <- global.millis();

    // SPN 171 - Ambient Air Temperature: bytes 3-4, 2 bytes, 0.03125 C/bit, -273 offset
    u16 raw171 <- this.extract_u16(data, 3, 4);
    i32 raw171_wide <- raw171[0, 16];
    SignalStore.current.ambient_temp_c.value <- raw171_wide * 0.03125 - 273.0;
    SignalStore.current.ambient_temp_c.time <- global.millis();
  }

  private void decode_65270(u8[8] data) {
    // SPN 173 - Exhaust Gas Temperature: spec pos 6-7 = 0-indexed bytes 5-6,
    // 2 bytes, 0.03125 C/bit, -273 offset. (PR #2 wrongly moved this to 4-5,
    // "verified" via a printf using %d on an f32 — UB; reverted.)
    u16 raw173 <- this.extract_u16(data, 5, 6);
    i32 raw173_wide <- raw173[0, 16];
    SignalStore.current.egt_c.value <- raw173_wide * 0.03125 - 273.0;
    SignalStore.current.egt_c.time <- global.millis();

    // SPN 102 - Engine Intake Manifold #1 Pressure (boost): byte 1, 1 byte, 2 kPa/bit
    u8 raw102 <- data[1];
    SignalStore.current.boost_kpa.value <- raw102 * 2.0;
    SignalStore.current.boost_kpa.time <- global.millis();
  }

  private void decode_65263(u8[8] data) {
    // SPN 94 - Fuel Delivery Pressure: byte 0, 1 byte, 4.0 kPa/bit
    u8 raw94 <- data[0];
    SignalStore.current.fuel_pressure_kpa.value <- raw94 * 4.0;
    SignalStore.current.fuel_pressure_kpa.time <- global.millis();
  }

  private void decode_65164(u8[8] data) {
    // SPN 354 - Relative Humidity: byte 6, 1 byte, 0.4 %/bit
    u8 raw354 <- data[6];
    SignalStore.current.relative_humidity_pct.value <- raw354 * 0.4;
    SignalStore.current.relative_humidity_pct.time <- global.millis();
  }

  private void decode_65262(u8[8] data) {
    // SPN 175 - Engine Oil Temperature 1: bytes 2-3, 2 bytes, 0.03125 C/bit, -273 offset
    u16 raw175 <- this.extract_u16(data, 2, 3);
    i32 raw175_wide <- raw175[0, 16];
    SignalStore.current.oil_temp_c.value <- raw175_wide * 0.03125 - 273.0;
    SignalStore.current.oil_temp_c.time <- global.millis();
  }

  private void decode_61444(u8[8] data) {
    // SPN 190 - Engine Speed: bytes 3-4, 2 bytes, 0.125 RPM/bit
    u16 raw190 <- this.extract_u16(data, 3, 4);
    i32 raw190_wide <- raw190[0, 16];
    SignalStore.current.rpm.value <- raw190_wide * 0.125;
    SignalStore.current.rpm.time <- global.millis();
  }

  private void decode_65248(u8[8] data) {
    // SPN 245 - Total Vehicle Distance: bytes 4-7, 4 bytes, 0.125 km/bit
    // 0xFFFFFFFF means not available in J1939 — skip update
    u32 raw245 <- this.extract_u32(data, 4, 5, 6, 7);
    if (raw245 != 0xFFFFFFFF) {
      SignalStore.current.total_dist_km.value <- raw245 * 0.125;
      SignalStore.current.total_dist_km.time <- global.millis();
    }
  }

  private void decode_61445(u8[8] data) {
    // PGN 61445 ETC2: lever = Requested Range char [4] (SPN 162),
    // demanded = Selected Gear [0] (SPN 524), actual = Current Gear [3] (SPN 523).
    // Gears are raw bytes (offset -125); the UI converts to characters.
    u8 lv <- data[4];
    u8 dm <- data[0];
    u8 ac <- data[3];
    bool changed <- false;
    if (lv != SignalStore.current.gear.lever)    { changed <- true; }
    if (dm != SignalStore.current.gear.demanded) { changed <- true; }
    if (ac != SignalStore.current.gear.actual)   { changed <- true; }
    SignalStore.current.gear.lever    <- lv;
    SignalStore.current.gear.demanded <- dm;
    SignalStore.current.gear.actual   <- ac;
    SignalStore.current.gear.time     <- global.millis();
    // Change-triggered only — a per-frame printf in the RX drain loop starves
    // the UI (see ui-starvation lesson). This prints once per lever/gear change.
    if (changed) {
      global.Serial.printf("GEAR: lever=%c(0x%02X) dmd=0x%02X cur=0x%02X\n", lv, lv, dm, ac);
    }
  }

  private void decode_65272(u8[8] data) {
    // PGN 65272 TRF1, SPN 177 Transmission Oil Temp 1: bytes 5-6 ([4][5]),
    // 0.03125 C/bit, -273 offset (same math as oil/EGT/ambient).
    u16 raw177 <- this.extract_u16(data, 4, 5);
    i32 raw177_wide <- raw177[0, 16];
    f32 temp <- raw177_wide * 0.03125 - 273.0;
    i32 prev_i <- SignalStore.current.trans_temp_c.value;
    i32 new_i <- temp;
    SignalStore.current.trans_temp_c.value <- temp;
    SignalStore.current.trans_temp_c.time <- global.millis();
    // Change-triggered on whole degrees (TRF1 is 1Hz; logging only on change).
    if (new_i != prev_i) {
      global.Serial.printf("TRANS TEMP: %d C (raw=%d)\n", new_i, raw177_wide);
    }
  }

  private void decode_65098(u8[8] data) {
    // PGN 65098 ETC7 telltales (2-bit J1939 status: 0=off 1=on 2=err 3=N/A).
    // tow/haul = byte3 [2] bits[4,2]; service = byte1 [0] bits[2,2];
    // warning = byte6 [5] bits[2,2]. Bench: tow byte3 0x4C=off, 0x1C=on.
    u8 b_tow  <- data[2];
    u8 b_svc  <- data[0];
    u8 b_warn <- data[5];
    u8 tow  <- b_tow[4, 2];
    u8 svc  <- b_svc[2, 2];
    u8 warn <- b_warn[2, 2];
    bool changed <- false;
    if (tow != SignalStore.current.tow_haul.state)       { changed <- true; }
    if (svc != SignalStore.current.trans_service.state)  { changed <- true; }
    if (warn != SignalStore.current.trans_warning.state) { changed <- true; }
    u32 now <- global.millis();
    SignalStore.current.tow_haul.state <- tow;
    SignalStore.current.tow_haul.time <- now;
    SignalStore.current.trans_service.state <- svc;
    SignalStore.current.trans_service.time <- now;
    SignalStore.current.trans_warning.state <- warn;
    SignalStore.current.trans_warning.time <- now;
    if (changed) {
      global.Serial.printf("ETC7: tow=%d svc=%d warn=%d (b3=0x%02X b1=0x%02X b6=0x%02X)\n",
          tow, svc, warn, b_tow, b_svc, b_warn);
    }
  }

  void decode(u16 pgn, u8 sa, u8[8] data) {
    // Gate each PGN to its expected source address so the TCM (SA_TCM)
    // can't clobber engine/sensor data with its overlapping re-broadcasts.
    // SA_ECM (0) — engine ECM
    if (pgn = 61444 && sa = SA_ECM) { this.decode_61444(data); }
    if (pgn = 65248 && sa = SA_ECM) { this.decode_65248(data); }
    // SA_SENSOR (1) — OSSM sensor module
    if (pgn = 65270 && sa = SA_SENSOR) { this.decode_65270(data); }
    if (pgn = 65262 && sa = SA_SENSOR) { this.decode_65262(data); }
    if (pgn = 65263 && sa = SA_SENSOR) { this.decode_65263(data); }
    if (pgn = 65269 && sa = SA_SENSOR) { this.decode_65269(data); }
    if (pgn = 65164 && sa = SA_SENSOR) { this.decode_65164(data); }
    // SA_TCM (3) — transmission control module
    if (pgn = 61445 && sa = SA_TCM) { this.decode_61445(data); }
    if (pgn = 65272 && sa = SA_TCM) { this.decode_65272(data); }
    if (pgn = 65098 && sa = SA_TCM) { this.decode_65098(data); }
  }
}
