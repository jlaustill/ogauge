#include <Arduino.h>
#include <lvgl.h>
#include "../data/signal_data.cnx"

scope GaugeTrans {
  lv_obj_t gear_val;
  lv_obj_t temp_title;
  lv_obj_t temp_val;
  lv_obj_t tow_chip;
  lv_obj_t svc_chip;
  lv_obj_t warn_chip;
  lv_obj_t boost_title;
  lv_obj_t boost_val;
  lv_obj_t turbo_val;
  private u8 flash_ctr <- 0;     // 100ms ticks, drives the error-state flash
  private bool flash_on <- false;

  // Convert a raw J1939 gear byte (offset -125) to a single display character.
  // Verified on the truck: 0x7C=-1 (reverse), 0x7D=0 (neutral), 0x7E=+1 (1st),
  // climbing 0x7F/0x80/0x81 = 2nd/3rd/4th. Park sends 0xFB (out of gear range)
  // which must read as no-gear '0' (P 0 0). 0xFF/0xFE = not available/error -> '-'.
  private u8 gear_char(u8 raw) {
    u8 result <- '0';              // default: no gear / park / neutral
    if (raw = 0xFF) { result <- '-'; }
    if (raw = 0xFE) { result <- '-'; }
    if (raw < 0xFE) {
      i32 g <- raw[0, 8];
      g <- g - 125;
      if (g >= 1 && g <= 9) {      // forward gear -> digit
        i32 cv <- 48 + g;
        result <- cv[0, 8];
      }
      if (g <= -1 && g >= -9) {    // reverse -> 'R'
        result <- 'R';
      }
      // g == 0 (neutral) or |g| > 9 (park 0xFB) fall through as '0'
    }
    return result;
  }

  // Lever char is ASCII from Requested Range. This Allison reports the Drive
  // detent as '6' (top range) -> show as 'D'; P/R/N and limited ranges 5..2
  // pass through; space/control -> '-'.
  private u8 lever_char(u8 raw) {
    u8 result <- raw;
    if (raw <= 0x20) { result <- '-'; }
    if (raw = 0x36) { result <- 'D'; }
    return result;
  }

  // 2-bit Status -> lit?  0 off / 3 N-A -> dim, 1 on -> lit, 2 error -> flashing.
  // Pure integer logic (no lv_obj_t param — C-Next marks handle params const).
  private bool chip_lit(u8 state) {
    bool lit <- false;
    if (state = 1) { lit <- true; }
    if (state = 2) { lit <- this.flash_on; }
    return lit;
  }

  // Maps a value to a warning level: 0 = normal, 1 = warning (>= warn_at),
  // 2 = critical (>= crit_at). Mirrors GaugeTemp.warn_level — kept per-scope
  // since C-Next scopes don't share private helpers.
  private u8 warn_level(i32 value, i32 warn_at, i32 crit_at) {
    u8 level <- 0;
    if (value >= warn_at) { level <- 1; }
    if (value >= crit_at) { level <- 2; }
    return level;
  }

  void update() {
    u32 now <- global.millis();

    // Flash timebase: ~500ms period at the 100ms timer (on for 3 ticks of 5).
    this.flash_ctr +<- 1;
    if (this.flash_ctr >= 5) { this.flash_ctr <- 0; }
    this.flash_on <- false;
    if (this.flash_ctr < 3) { this.flash_on <- true; }

    // TRANS oil temp — warn orange >=120C, critical red w/ blinking box >=135C (Allison limits).
    bool blink <- this.flash_on;
    u32 temp_age <- now - SignalStore.current.trans_temp_c.time;
    u32 temp_color <- 0xFFFFFF;
    u8 temp_box <- 0;
    if (temp_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.temp_val, "---- C");
    } else {
      i32 t <- SignalStore.current.trans_temp_c.value;
      global.lv_label_set_text_fmt(this.temp_val, "%d C", t);
      u8 temp_level <- this.warn_level(t, 120, 135);
      if (temp_level = 1) {
        temp_color <- 0xFF8C00;
        temp_box <- 255;
      }
      if (temp_level = 2) {
        temp_color <- 0xFF3333;
        temp_box <- 0;
        if (blink = true) { temp_box <- 255; }
      }
    }
    global.lv_obj_set_style_text_color(this.temp_val, global.lv_color_hex(temp_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.temp_val, global.lv_color_hex(temp_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.temp_val, temp_box, LV_PART_MAIN);

    // BOOST — convert native kPa to psi for display; no warning styling.
    u32 boost_age <- now - SignalStore.current.boost_kpa.time;
    if (boost_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.boost_val, "---- psi");
    } else {
      i32 psi <- SignalStore.current.boost_kpa.value * 0.145038;
      global.lv_label_set_text_fmt(this.boost_val, "%d psi", psi);
    }

    // TURBO MCU temp (OVGT controller board, PGN 65500) — compact diagnostic
    // readout above BOOST. Informational, no warning styling.
    u32 turbo_age <- now - SignalStore.current.turbo_mcu_temp_c.time;
    if (turbo_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.turbo_val, "TURBO -- C");
    } else {
      i32 tt <- SignalStore.current.turbo_mcu_temp_c.value;
      global.lv_label_set_text_fmt(this.turbo_val, "TURBO %d C", tt);
    }

    // Telltale chips (inlined per field — proven pattern; arrays/handle-params
    // hit C-Next codegen bugs).
    bool tow_lit <- this.chip_lit(SignalStore.current.tow_haul.state);
    if (tow_lit = true) {
      global.lv_obj_set_style_text_color(this.tow_chip, global.lv_color_hex(0x4488FF), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.tow_chip, global.lv_color_hex(0x4488FF), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.tow_chip, 255, LV_PART_MAIN);
    } else {
      global.lv_obj_set_style_text_color(this.tow_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.tow_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.tow_chip, 60, LV_PART_MAIN);
    }

    bool svc_lit <- this.chip_lit(SignalStore.current.trans_service.state);
    if (svc_lit = true) {
      global.lv_obj_set_style_text_color(this.svc_chip, global.lv_color_hex(0xFFAA00), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.svc_chip, global.lv_color_hex(0xFFAA00), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.svc_chip, 255, LV_PART_MAIN);
    } else {
      global.lv_obj_set_style_text_color(this.svc_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.svc_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.svc_chip, 60, LV_PART_MAIN);
    }

    bool warn_lit <- this.chip_lit(SignalStore.current.trans_warning.state);
    if (warn_lit = true) {
      global.lv_obj_set_style_text_color(this.warn_chip, global.lv_color_hex(0xFF3333), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.warn_chip, global.lv_color_hex(0xFF3333), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.warn_chip, 255, LV_PART_MAIN);
    } else {
      global.lv_obj_set_style_text_color(this.warn_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
      global.lv_obj_set_style_border_color(this.warn_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
      global.lv_obj_set_style_border_opa(this.warn_chip, 60, LV_PART_MAIN);
    }

    u32 age <- now - SignalStore.current.gear.time;
    if (age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.gear_val, "-  -  -");
    } else {
      u8 lv <- this.lever_char(SignalStore.current.gear.lever);
      u8 dm <- this.gear_char(SignalStore.current.gear.demanded);
      u8 ac <- this.gear_char(SignalStore.current.gear.actual);
      global.lv_label_set_text_fmt(this.gear_val, "%c  %c  %c", lv, dm, ac);
    }
  }

  private void on_update_timer(lv_timer_t t) {
    this.update();
  }

  void create() {
    lv_obj_t scr <- global.lv_screen_active();

    this.gear_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.gear_val, "-  -  -");
    global.lv_obj_align(this.gear_val, LV_ALIGN_BOTTOM_MID, 0, -10);
    global.lv_obj_set_style_text_font(this.gear_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.gear_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    // Trans oil temp — left side, label tucked ~10px under the TOW chip
    this.temp_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.temp_title, "TRANS");
    global.lv_obj_align(this.temp_title, LV_ALIGN_LEFT_MID, 31, 38);
    global.lv_obj_set_style_text_font(this.temp_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.temp_title, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    this.temp_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.temp_val, "---- C");
    global.lv_obj_align(this.temp_val, LV_ALIGN_LEFT_MID, 36, 81);
    global.lv_obj_set_style_text_font(this.temp_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.temp_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.temp_val, 3, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.temp_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_left(this.temp_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_right(this.temp_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.temp_val, 0, LV_PART_MAIN);

    // BOOST — top-left, vertical mirror of the bottom-left trans temp. White,
    // no warning box (boost is informational). Value on top, label below.
    this.boost_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.boost_val, "---- psi");
    global.lv_obj_align(this.boost_val, LV_ALIGN_LEFT_MID, 41, -126);
    global.lv_obj_set_style_text_font(this.boost_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.boost_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    this.boost_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.boost_title, "BOOST");
    global.lv_obj_align(this.boost_title, LV_ALIGN_LEFT_MID, 31, -83);
    global.lv_obj_set_style_text_font(this.boost_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.boost_title, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    // TURBO MCU temp — compact single line above BOOST, indented right to clear
    // the circle edge near the top bezel. Gray (diagnostic, not a primary gauge).
    this.turbo_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.turbo_val, "TURBO -- C");
    global.lv_obj_align(this.turbo_val, LV_ALIGN_LEFT_MID, 60, -160);
    global.lv_obj_set_style_text_font(this.turbo_val, lv_font_montserrat_14, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.turbo_val, global.lv_color_hex(0xAAAAAA), LV_PART_MAIN);

    // Telltale chips — TOW/WARN/SVC left-aligned column hugging the left edge, 5px apart (base styling
    // inlined per field; dim by default, lit each frame by update()).
    this.tow_chip <- global.lv_label_create(scr);
    global.lv_label_set_text(this.tow_chip, "TOW");
    global.lv_obj_align(this.tow_chip, LV_ALIGN_LEFT_MID, 11, 0);
    global.lv_obj_set_style_text_font(this.tow_chip, lv_font_montserrat_14, LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.tow_chip, 2, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.tow_chip, 4, LV_PART_MAIN);
    global.lv_obj_set_style_pad_all(this.tow_chip, 3, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.tow_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.tow_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.tow_chip, 60, LV_PART_MAIN);

    this.svc_chip <- global.lv_label_create(scr);
    global.lv_label_set_text(this.svc_chip, "SVC");
    global.lv_obj_align(this.svc_chip, LV_ALIGN_LEFT_MID, 11, -54);
    global.lv_obj_set_style_text_font(this.svc_chip, lv_font_montserrat_14, LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.svc_chip, 2, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.svc_chip, 4, LV_PART_MAIN);
    global.lv_obj_set_style_pad_all(this.svc_chip, 3, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.svc_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.svc_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.svc_chip, 60, LV_PART_MAIN);

    this.warn_chip <- global.lv_label_create(scr);
    global.lv_label_set_text(this.warn_chip, "WARN");
    global.lv_obj_align(this.warn_chip, LV_ALIGN_LEFT_MID, 11, -27);
    global.lv_obj_set_style_text_font(this.warn_chip, lv_font_montserrat_14, LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.warn_chip, 2, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.warn_chip, 4, LV_PART_MAIN);
    global.lv_obj_set_style_pad_all(this.warn_chip, 3, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.warn_chip, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.warn_chip, global.lv_color_hex(0x444444), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.warn_chip, 60, LV_PART_MAIN);

    global.lv_timer_create(this.on_update_timer, 100, 0);
  }
}
