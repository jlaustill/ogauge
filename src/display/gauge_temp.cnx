#include <Arduino.h>
#include <lvgl.h>
#include "../data/signal_data.cnx"

scope GaugeTemp {
  lv_obj_t egt_title;
  lv_obj_t egt_val;
  lv_obj_t oil_title;
  lv_obj_t oil_val;
  lv_obj_t fuel_title;
  lv_obj_t fuel_val;
  lv_obj_t rpm_title;
  lv_obj_t rpm_val;
  lv_obj_t odo_title;
  lv_obj_t odo_val;
  private u8 flash_ctr <- 0;     // 100ms ticks, drives the critical-state box blink

  // Maps a value to a warning level: 0 = normal, 1 = warning (>= warn_at),
  // 2 = critical (>= crit_at). Pure integer logic (no lv_obj_t param — those
  // hit C-Next handle codegen bugs); callers inline the styling per level.
  private u8 warn_level(i32 value, i32 warn_at, i32 crit_at) {
    u8 level <- 0;
    if (value >= warn_at) { level <- 1; }
    if (value >= crit_at) { level <- 2; }
    return level;
  }

  void update() {
    u32 now <- global.millis();

    // Flash timebase: ~500ms period (on 3 of 5 ticks) for blinking warnings.
    this.flash_ctr +<- 1;
    if (this.flash_ctr >= 5) { this.flash_ctr <- 0; }
    bool flash_on <- false;
    if (this.flash_ctr < 3) { flash_on <- true; }

    // EGT — warn orange >=675C, critical red w/ blinking box >=750C.
    u32 egt_age <- now - SignalStore.current.egt_c.time;
    u32 egt_color <- 0xFFFFFF;
    u8 egt_box <- 0;
    if (egt_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.egt_val, "---- C");
    } else {
      i32 egt <- SignalStore.current.egt_c.value;
      global.lv_label_set_text_fmt(this.egt_val, "%d C", egt);
      u8 egt_level <- this.warn_level(egt, 675, 750);
      if (egt_level = 1) {
        egt_color <- 0xFF8C00;
        egt_box <- 255;
      }
      if (egt_level = 2) {
        egt_color <- 0xFF3333;
        egt_box <- 0;
        if (flash_on) { egt_box <- 255; }
      }
    }
    global.lv_obj_set_style_text_color(this.egt_val, global.lv_color_hex(egt_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.egt_val, global.lv_color_hex(egt_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.egt_val, egt_box, LV_PART_MAIN);

    // OIL — warn orange >=120C, critical red w/ blinking box >=140C (Cummins 5.9 oil limits).
    u32 oil_age <- now - SignalStore.current.oil_temp_c.time;
    u32 oil_color <- 0xFFFFFF;
    u8 oil_box <- 0;
    if (oil_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.oil_val, "---- C");
    } else {
      i32 oil <- SignalStore.current.oil_temp_c.value;
      global.lv_label_set_text_fmt(this.oil_val, "%d C", oil);
      u8 oil_level <- this.warn_level(oil, 120, 140);
      if (oil_level = 1) {
        oil_color <- 0xFF8C00;
        oil_box <- 255;
      }
      if (oil_level = 2) {
        oil_color <- 0xFF3333;
        oil_box <- 0;
        if (flash_on) { oil_box <- 255; }
      }
    }
    global.lv_obj_set_style_text_color(this.oil_val, global.lv_color_hex(oil_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_color(this.oil_val, global.lv_color_hex(oil_color), LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.oil_val, oil_box, LV_PART_MAIN);

    // FUEL removed until pressure sensor is hooked up — re-enable to restore.
    /*
    u32 fuel_age <- now - SignalStore.current.fuel_pressure_kpa.time;
    if (fuel_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.fuel_val, "---- kPa");
    } else {
      i32 fuel <- SignalStore.current.fuel_pressure_kpa.value;
      global.lv_label_set_text_fmt(this.fuel_val, "%d kPa", fuel);
    }
    */

    u32 rpm_age <- now - SignalStore.current.rpm.time;
    if (rpm_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.rpm_val, "----");
    } else {
      i32 rpm <- SignalStore.current.rpm.value;
      global.lv_label_set_text_fmt(this.rpm_val, "%d", rpm);
    }

    u32 odo_age <- now - SignalStore.current.total_dist_km.time;
    if (odo_age > SIGNAL_STALE_MS) {
      global.lv_label_set_text(this.odo_val, "----");
    } else {
      i32 odo <- SignalStore.current.total_dist_km.value * 0.621371;
      global.lv_label_set_text_fmt(this.odo_val, "%d", odo);
    }
  }

  private void on_update_timer(lv_timer_t t) {
    this.update();
  }

  void create() {
    lv_obj_t scr <- global.lv_screen_active();
    global.lv_obj_set_style_bg_color(scr, global.lv_color_hex(0x1A1A2E), LV_PART_MAIN);

    // EGT — white, value hugs top edge, label below
    this.egt_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.egt_title, "EGT");
    global.lv_obj_align(this.egt_title, LV_ALIGN_TOP_MID, 0, 54);
    global.lv_obj_set_style_text_font(this.egt_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.egt_title, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    this.egt_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.egt_val, "---- C");
    global.lv_obj_align(this.egt_val, LV_ALIGN_TOP_MID, 0, 10);
    global.lv_obj_set_style_text_font(this.egt_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.egt_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.egt_val, 3, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.egt_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_left(this.egt_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_right(this.egt_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.egt_val, 0, LV_PART_MAIN);

    // OIL — white, value borders EGT, label below
    this.oil_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.oil_title, "OIL");
    global.lv_obj_align(this.oil_title, LV_ALIGN_TOP_MID, 0, 133);
    global.lv_obj_set_style_text_font(this.oil_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.oil_title, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    this.oil_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.oil_val, "---- C");
    global.lv_obj_align(this.oil_val, LV_ALIGN_TOP_MID, 0, 89);
    global.lv_obj_set_style_text_font(this.oil_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.oil_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);
    global.lv_obj_set_style_border_width(this.oil_val, 3, LV_PART_MAIN);
    global.lv_obj_set_style_radius(this.oil_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_left(this.oil_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_pad_right(this.oil_val, 6, LV_PART_MAIN);
    global.lv_obj_set_style_border_opa(this.oil_val, 0, LV_PART_MAIN);

    // FUEL removed until pressure sensor is hooked up — re-enable to restore.
    /*
    this.fuel_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.fuel_title, "FUEL");
    global.lv_obj_align(this.fuel_title, LV_ALIGN_CENTER, 0, -14);
    global.lv_obj_set_style_text_font(this.fuel_title, lv_font_montserrat_14, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.fuel_title, global.lv_color_hex(0x44BB44), LV_PART_MAIN);

    this.fuel_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.fuel_val, "---- kPa");
    global.lv_obj_align(this.fuel_val, LV_ALIGN_CENTER, 0, 12);
    global.lv_obj_set_style_text_font(this.fuel_val, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.fuel_val, global.lv_color_hex(0x44BB44), LV_PART_MAIN);
    */

    // RPM — white, label above value; value borders the gear (D 1 1)
    this.rpm_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.rpm_title, "RPM");
    global.lv_obj_align(this.rpm_title, LV_ALIGN_TOP_MID, 0, 347);
    global.lv_obj_set_style_text_font(this.rpm_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.rpm_title, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    this.rpm_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.rpm_val, "----");
    global.lv_obj_align(this.rpm_val, LV_ALIGN_TOP_MID, 0, 382);
    global.lv_obj_set_style_text_font(this.rpm_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.rpm_val, global.lv_color_hex(0xFFFFFF), LV_PART_MAIN);

    // ODO — gray, label above value; unit moved into the label ("ODO (mi)")
    this.odo_title <- global.lv_label_create(scr);
    global.lv_label_set_text(this.odo_title, "ODO (mi)");
    global.lv_obj_align(this.odo_title, LV_ALIGN_TOP_MID, 0, 268);
    global.lv_obj_set_style_text_font(this.odo_title, lv_font_montserrat_32, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.odo_title, global.lv_color_hex(0xAAAAAA), LV_PART_MAIN);

    this.odo_val <- global.lv_label_create(scr);
    global.lv_label_set_text(this.odo_val, "----");
    global.lv_obj_align(this.odo_val, LV_ALIGN_TOP_MID, 0, 303);
    global.lv_obj_set_style_text_font(this.odo_val, lv_font_montserrat_40, LV_PART_MAIN);
    global.lv_obj_set_style_text_color(this.odo_val, global.lv_color_hex(0xAAAAAA), LV_PART_MAIN);

    global.lv_timer_create(this.on_update_timer, 100, 0);
  }
}
